#!/usr/bin/env bash
# Creates an easy-db-lab wrapper script in a cluster workspace directory.
#
# Usage: bin/create-easy-db-lab-wrapper <dir>
#
# The generated wrapper sets JAVA_HOME to a compatible JDK found via mise, SDKMAN, or system PATH,
# changes into the workspace directory, and execs bin/easy-db-lab. Every
# invocation of the wrapper automatically runs from the correct working
# directory with the correct JDK.
#
# The CLI is built as Java 21 bytecode, so it runs on Java 21 or any newer JVM
# (e.g. 25). Java 21 is the preferred runtime; if no Java 21 is installed, the
# newest installed JDK >= 21 is used as a fallback.

DIR="${1:?Usage: $0 <dir>}"

WORKTREE_ROOT=$(cd "$(dirname "$0")/.." && pwd)

DIR=$(cd "$DIR" && pwd)

JAVA_HOME_DIR=""

# 1. Check mise if available
if command -v mise >/dev/null 2>&1; then
    JAVA_HOME_DIR=$(mise where java@21 2>/dev/null || mise where java 2>/dev/null || true)
fi

# 2. Fall back to SDKMAN if available
if [[ -z "$JAVA_HOME_DIR" && -f "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.sdkman/bin/sdkman-init.sh"
    CANDIDATES="$HOME/.sdkman/candidates/java"
    if [[ -d "$CANDIDATES" ]]; then
        JAVA_ID=$(ls "$CANDIDATES" 2>/dev/null | grep "^21\." | sort -V | tail -1)
        if [[ -z "$JAVA_ID" ]]; then
            JAVA_ID=$(ls "$CANDIDATES" 2>/dev/null | awk -F. '$1 >= 21' | sort -V | tail -1)
        fi
        if [[ -n "$JAVA_ID" ]]; then
            JAVA_HOME_DIR=$(sdk home java "$JAVA_ID" 2>/dev/null || true)
        fi
    fi
fi

# 3. Fall back to existing JAVA_HOME or system java
if [[ -z "$JAVA_HOME_DIR" ]]; then
    if [[ -n "$JAVA_HOME" && -d "$JAVA_HOME" ]]; then
        JAVA_HOME_DIR="$JAVA_HOME"
    elif command -v java >/dev/null 2>&1; then
        JAVA_HOME_DIR=$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")
    fi
fi

if [[ -z "$JAVA_HOME_DIR" ]]; then
    echo "error: no Java 21+ installation found via mise, SDKMAN, or PATH" >&2
    exit 1
fi

WRAPPER="$DIR/easy-db-lab"

cat > "$WRAPPER" <<EOF
#!/usr/bin/env bash
export JAVA_HOME="$JAVA_HOME_DIR"
cd "$DIR"
exec "$WORKTREE_ROOT/bin/easy-db-lab" "\$@"
EOF

chmod +x "$WRAPPER"
echo "created: $WRAPPER"
echo "  java:    $JAVA_HOME_DIR"
echo "  workdir: $DIR"
