apiVersion: v1
kind: Service
metadata:
  name: __KIT_NAME__-nodeport
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: regatta
    app.kubernetes.io/instance: __KIT_NAME__
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: regatta
    app.kubernetes.io/instance: __KIT_NAME__
    app.kubernetes.io/component: sm
  ports:
    - name: sm-port
      port: 8840
      targetPort: 8840
      nodePort: 30840
