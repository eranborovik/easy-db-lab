#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(dirname "${SCRIPT_DIR}")"
CLUSTER_DIR="$(cd "${KIT_DIR}/../.." && pwd)"

if [ -f "${CLUSTER_DIR}/env.sh" ]; then
  # Source env.sh for environment aliases and proxy configs if available
  # shellcheck source=/dev/null
  source "${CLUSTER_DIR}/env.sh" >/dev/null 2>&1 || true
fi

KUBECONFIG="${KUBECONFIG:-${CLUSTER_DIR}/kubeconfig}"

echo "=== Regatta Setup: Dynamic Node Resource Discovery & Sizing ==="
NUM_THREADS="${RDB_NUM_THREADS:-}"
RAM_MB="${RDB_RAM_MB:-}"
SEQ_THREADS="${SEQUENCER_NUM_THREADS:-}"

if [ -z "$NUM_THREADS" ] || [ -z "$RAM_MB" ] || [ -z "$SEQ_THREADS" ]; then
  echo "Discovering DB node capacity via kubectl..."

  # 1. Primary: Discover DB node capacity via kubectl
  NODE_CPU=$(kubectl --kubeconfig="${KUBECONFIG}" get nodes -l type=db -o jsonpath='{.items[0].status.capacity.cpu}' 2>/dev/null || true)
  NODE_MEM_RAW=$(kubectl --kubeconfig="${KUBECONFIG}" get nodes -l type=db -o jsonpath='{.items[0].status.capacity.memory}' 2>/dev/null || true)

  MEM_TOTAL_MB=""
  if [ -n "$NODE_MEM_RAW" ]; then
    if [[ "$NODE_MEM_RAW" =~ ^([0-9]+)Ki$ ]]; then
      MEM_TOTAL_MB=$(( ${BASH_REMATCH[1]} / 1024 ))
    elif [[ "$NODE_MEM_RAW" =~ ^([0-9]+)Mi$ ]]; then
      MEM_TOTAL_MB="${BASH_REMATCH[1]}"
    elif [[ "$NODE_MEM_RAW" =~ ^([0-9]+)Gi$ ]]; then
      MEM_TOTAL_MB=$(( ${BASH_REMATCH[1]} * 1024 ))
    elif [[ "$NODE_MEM_RAW" =~ ^([0-9]+)Ti$ ]]; then
      MEM_TOTAL_MB=$(( ${BASH_REMATCH[1]} * 1024 * 1024 ))
    elif [[ "$NODE_MEM_RAW" =~ ^([0-9]+)$ ]]; then
      MEM_TOTAL_MB=$(( ${BASH_REMATCH[1]} / 1024 / 1024 ))
    fi
  fi

  # Fallback to defaults if discovery failed
  NODE_CPU="${NODE_CPU:-16}"
  MEM_TOTAL_MB="${MEM_TOTAL_MB:-32768}"

  # Compute Sequencer threads (GDD=1, DCM=1 are constant)
  # > 18 cores: Sequencer = 4 (SM CPU = 6)
  # 9-18 cores: Sequencer = 2 (SM CPU = 4)
  # <= 8 cores: Sequencer = 1 (SM CPU = 3)
  if [ -z "$SEQ_THREADS" ]; then
    if [ "$NODE_CPU" -gt 18 ]; then
      SEQ_THREADS=4
    elif [ "$NODE_CPU" -ge 9 ]; then
      SEQ_THREADS=2
    else
      SEQ_THREADS=1
    fi
  fi

  # SM pod CPU = Sequencer + GDD(1) + DCM(1)
  SM_CPU=$(( SEQ_THREADS + 2 ))

  # Compute RDB threads:
  # Aim for total budget = floor(0.80 * NODE_CPU).
  # RDB_CPU = max(6, Budget - SM_CPU) when NODE_CPU >= 9,
  # or max(1, NODE_CPU - SM_CPU) for smaller nodes.
  if [ -z "$NUM_THREADS" ]; then
    NUM_THREADS=$(awk -v c="$NODE_CPU" -v sm="$SM_CPU" 'BEGIN {
      budget = int(c * 0.8);
      rdb = budget - sm;
      if (c >= 9) {
        if (rdb < 6) rdb = 6;
      } else {
        if (rdb < 1) rdb = int(c - sm);
        if (rdb < 1) rdb = 1;
      }
      print rdb;
    }')
  fi

  # Compute 80% RAM in Megabytes (integer >= 1024)
  if [ -z "$RAM_MB" ]; then
    RAM_MB=$(awk -v m="$MEM_TOTAL_MB" 'BEGIN { mb=int(m * 0.8); if (mb < 1024) mb=1024; print mb }')
  fi
fi

# Derive SM total CPU
SM_CPU=$(( SEQ_THREADS + 2 ))

echo "Computed Regatta sizing: sequencer_threads=${SEQ_THREADS} (sm_cpu=${SM_CPU}), rdb_threads=${NUM_THREADS}, ram_MB=${RAM_MB}M"

CLUSTER_YAML="${KIT_DIR}/regattacluster.yaml"

if [ -f "$CLUSTER_YAML" ]; then
  echo "Configuring ${CLUSTER_YAML} with node sizing (sequencer=${SEQ_THREADS}, sm_cpu=${SM_CPU}, rdb_threads=${NUM_THREADS}, ram_MB=${RAM_MB}M)..."
  python3 -c "
import re

with open('${CLUSTER_YAML}', 'r') as f:
    content = f.read()

# Replace template placeholders or existing values
content = content.replace('__SEQUENCER_NUM_THREADS__', '${SEQ_THREADS}')
content = content.replace('__SM_CPU__', '${SM_CPU}')
content = content.replace('__RDB_NUM_THREADS__', '${NUM_THREADS}')
content = content.replace('__RDB_RAM_MB__', '${RAM_MB}')

# 1. Target spec.sequencer.num_threads
seq_pattern = r'(  sequencer:\n(?:    [^\n]+\n)*?    num_threads:\s*)[0-9]+'
content = re.sub(seq_pattern, r'\g<1>${SEQ_THREADS}', content)

# 2. Target spec.rdb.num_threads and spec.rdb.ram_MB specifically
rdb_block_pattern = r'(  rdb:\n(?:    [^\n]+\n)*?    num_threads:\s*)[0-9]+(\n(?:    [^\n]+\n)*?    ram_MB:\s*)[0-9]+'
content = re.sub(rdb_block_pattern, r'\g<1>${NUM_THREADS}\g<2>${RAM_MB}', content)

# 3. Target spec.resources.sm requests & limits cpu
sm_res_pattern = r'(    sm:\s*\n\s*requests:\s*\n\s*cpu:\s*)[^\n]+(\n\s*memory:\s*[^\\n]+\n\s*limits:\s*\n\s*cpu:\s*)[^\n]+'
content = re.sub(sm_res_pattern, r'\g<1>\"${SM_CPU}\"\g<2>\"${SM_CPU}\"', content)

# 4. Target spec.resources.rdb requests & limits cpu/memory specifically
rdb_res_pattern = r'(    rdb:\s*\n\s*requests:\s*\n\s*cpu:\s*)[^\n]+(\n\s*memory:\s*)[^\n]+(\n\s*limits:\s*\n\s*cpu:\s*)[^\n]+(\n\s*memory:\s*)[^\n]+'
replacement = r'\g<1>\"${NUM_THREADS}\"\g<2>${RAM_MB}M\g<3>\"${NUM_THREADS}\"\g<4>${RAM_MB}M'
content = re.sub(rdb_res_pattern, replacement, content)

with open('${CLUSTER_YAML}', 'w') as f:
    f.write(content)
" 2>/dev/null || true
fi
