#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(dirname "${SCRIPT_DIR}")"
CLUSTER_DIR="$(cd "${KIT_DIR}/../.." && pwd)"

if [ -f "${CLUSTER_DIR}/env.sh" ]; then
  # shellcheck source=/dev/null
  source "${CLUSTER_DIR}/env.sh" >/dev/null 2>&1 || true
fi

KUBECONFIG="${KUBECONFIG:-${CLUSTER_DIR}/kubeconfig}"
SM_STATEFULSET="${KIT_NAME}-sm"
SM_POD="${SM_STATEFULSET}-0"
SM_NODE_TYPE="${SM_NODE_TYPE:-}"
SM_NODE_ORDINAL="${SM_NODE_ORDINAL:-}"

echo "=== Regatta Setup: Pinning SM StatefulSet to a dedicated node ==="

node_selector() {
  if [ -n "$2" ]; then
    echo "type=$1,easydblab.com/node-ordinal=$2"
  else
    echo "type=$1"
  fi
}

find_node() {
  kubectl --kubeconfig="${KUBECONFIG}" get nodes -l "$1" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true
}

# Mirror the sizing branch in start.sh: a lone db node reserves sm_cpu for SM, so SM
# belongs there; with several db nodes each RDB owns a whole node and SM needs its own.
if [ -z "${SM_NODE_TYPE}" ]; then
  DB_NODES_COUNT="${DB_NODE_COUNT:-}"
  if [ -z "${DB_NODES_COUNT}" ] || [ "${DB_NODES_COUNT}" = "0" ]; then
    DB_NODES_COUNT=$(kubectl --kubeconfig="${KUBECONFIG}" get nodes -l type=db --no-headers 2>/dev/null | awk 'END { print NR }' || true)
  fi
  DB_NODES_COUNT="${DB_NODES_COUNT:-1}"

  if [ "${DB_NODES_COUNT}" -gt 1 ]; then
    SM_NODE_TYPE="app"
    SM_NODE_ORDINAL="${SM_NODE_ORDINAL:-1}"
  else
    SM_NODE_TYPE="db"
    SM_NODE_ORDINAL="${SM_NODE_ORDINAL:-0}"
  fi
  echo "Derived SM placement from ${DB_NODES_COUNT} db node(s): type=${SM_NODE_TYPE}, ordinal=${SM_NODE_ORDINAL}."
fi

SELECTOR="$(node_selector "${SM_NODE_TYPE}" "${SM_NODE_ORDINAL}")"
TARGET_NODE="$(find_node "${SELECTOR}")"

# Clusters provisioned without a dedicated SM node still need somewhere to put SM.
if [ -z "${TARGET_NODE}" ]; then
  echo "No node matched '${SELECTOR}'; falling back to the control node."
  SM_NODE_TYPE="control"
  SM_NODE_ORDINAL=""
  SELECTOR="$(node_selector "${SM_NODE_TYPE}" "${SM_NODE_ORDINAL}")"
  TARGET_NODE="$(find_node "${SELECTOR}")"
fi

if [ -z "${TARGET_NODE}" ]; then
  echo "No Kubernetes node matched '${SELECTOR}'; cannot pin ${SM_STATEFULSET}." >&2
  exit 1
fi

echo "Targeting node ${TARGET_NODE} (${SELECTOR}) for ${SM_STATEFULSET}."

found_statefulset=false
for _ in $(seq 1 60); do
  if kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" get statefulset "${SM_STATEFULSET}" >/dev/null 2>&1; then
    found_statefulset=true
    break
  fi
  sleep 2
done

if [ "${found_statefulset}" != "true" ]; then
  echo "Timed out waiting for StatefulSet ${NAMESPACE}/${SM_STATEFULSET}." >&2
  exit 1
fi

PATCH_FILE=$(mktemp /tmp/regatta-sm-placement-XXXXXX.yaml)
trap 'rm -f "${PATCH_FILE}"' EXIT

{
  echo "spec:"
  echo "  template:"
  echo "    spec:"
  echo "      nodeSelector:"
  echo "        type: ${SM_NODE_TYPE}"
  if [ -n "${SM_NODE_ORDINAL}" ]; then
    echo "        easydblab.com/node-ordinal: \"${SM_NODE_ORDINAL}\""
  fi
  if [ "${SM_NODE_TYPE}" = "control" ]; then
    echo "      tolerations:"
    echo "        - key: node-role.kubernetes.io/control-plane"
    echo "          operator: Exists"
    echo "          effect: NoSchedule"
  fi
} > "${PATCH_FILE}"

kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" patch statefulset "${SM_STATEFULSET}" --type=strategic --patch-file "${PATCH_FILE}"

CURRENT_NODE=$(kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" get pod "${SM_POD}" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)
if [ "${CURRENT_NODE}" != "${TARGET_NODE}" ]; then
  echo "Recreating ${SM_POD}; current node is ${CURRENT_NODE:-<none>}, target node is ${TARGET_NODE}."
  kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" scale statefulset "${SM_STATEFULSET}" --replicas=0
  kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" wait --for=delete pod "${SM_POD}" --timeout=180s 2>/dev/null || true
  kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" delete pvc "repo-${SM_POD}" "logs-${SM_POD}" --ignore-not-found=true
  kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" scale statefulset "${SM_STATEFULSET}" --replicas=1
fi

kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" rollout status statefulset/"${SM_STATEFULSET}" --timeout=180s

ASSIGNED_NODE=$(kubectl --kubeconfig="${KUBECONFIG}" -n "${NAMESPACE}" get pod "${SM_POD}" -o jsonpath='{.spec.nodeName}' 2>/dev/null || true)
if [ "${ASSIGNED_NODE}" != "${TARGET_NODE}" ]; then
  echo "${SM_POD} is running on '${ASSIGNED_NODE:-<none>}' instead of target node '${TARGET_NODE}'." >&2
  exit 1
fi

echo "${SM_POD} is pinned to ${TARGET_NODE}."
