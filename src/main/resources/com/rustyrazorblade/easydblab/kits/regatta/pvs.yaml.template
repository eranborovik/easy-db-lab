apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-rdb-block-__KIT_NAME__-rdb-0
  labels:
    regatta.dev/cluster: __KIT_NAME__-static
spec:
  capacity:
    storage: __STORAGE_SIZE__
  volumeMode: Block
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-storage
  local:
    path: __RDB_DEVICE__
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: easydblab.com/node-ordinal
              operator: In
              values:
                - "0"
---
