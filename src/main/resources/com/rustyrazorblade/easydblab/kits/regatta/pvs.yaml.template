  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-storage
  local:
    path: /mnt/db1/__KIT_NAME__/repo-sm-0
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: easydblab.com/node-ordinal
              operator: In
              values:
                - "0"
